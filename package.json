{
  "name": "kira-ftp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:view": "vite build",
    "build": "vite build && electrobun build",
    "build:canary": "vite build && electrobun build --env=canary",
    "build:stable": "vite build && electrobun build --env=stable",
    "dev": "vite build && electrobun dev",
    "dev:vite": "vite --port 5173",
    "build:cli": "bun build --compile src/cli/kira.ts --outfile dist-cli/kira",
    "typecheck": "tsc --noEmit"
  },
